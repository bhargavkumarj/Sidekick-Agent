# ---- required -------------------------------------------------------------
OPENAI_API_KEY=sk-...

# ---- optional -------------------------------------------------------------
# Google Serper web search. Without it the Sidekick still has Wikipedia and a
# real browser, but no search tool — it is told so rather than handed one that
# 401s on every call. https://serper.dev
# SERPER_API_KEY=

# Push notifications to your phone. Without these the tool logs instead.
# PUSHOVER_USER=
# PUSHOVER_TOKEN=

# ---- models ---------------------------------------------------------------
# WORKER_MODEL=openai:gpt-5.4-mini      # does the task (LangChain model string)
# EVALUATOR_MODEL=gpt-5.4-mini          # judges it (plain OpenAI model id)

# ---- guardrails -----------------------------------------------------------
# MAX_ATTEMPTS=3          # evaluator retries before the turn ends regardless
# MODEL_CALL_LIMIT=30     # model calls inside one worker run — the cost ceiling
# SIDEKICK_SANDBOX=./sandbox   # the only directory the agent may write to
